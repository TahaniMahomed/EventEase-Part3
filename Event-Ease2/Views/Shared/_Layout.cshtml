<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventEase</title>

```
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/Event_Ease2.styles.css"
      asp-append-version="true" />

<style>

    :root {
        --gold: #c8a96a;
        --dark: #0f172a;
        --dark-alt: #08111d;
        --light: #ffffff;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: #fafafa;
        color: #334155;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ==========================
       NAVBAR
    ========================== */

    .premium-navbar {

        background: rgba(15,23,42,.90);

        backdrop-filter: blur(12px);

        border-bottom: 1px solid rgba(255,255,255,.08);

        padding: 16px 0;

        z-index: 1000;
    }

    .premium-navbar .nav-link {

        color: rgba(255,255,255,.85) !important;

        font-weight: 500;

        transition: .3s;
    }

    .premium-navbar .nav-link:hover {

        color: var(--gold) !important;
    }

    .premium-navbar .navbar-brand {

        color: white !important;

        font-weight: 700;
    }

    .logo-icon {

        width: 42px;

        height: 42px;

        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #c8a96a,
            #b8924d
        );

        display: flex;

        align-items: center;

        justify-content: center;

        color: white;
    }

    .btn-signin {

        background: var(--gold);

        border: none;

        color: white;

        padding: 10px 22px;

        border-radius: 50px;

        font-weight: 600;

        transition: .3s;
    }

    .btn-signin:hover {

        background: #b8924d;

        transform: translateY(-2px);
    }

    /* ==========================
       ALERTS
    ========================== */

    .alert {
        border: none;
        border-radius: 15px;
    }

    /* ==========================
       FOOTER
    ========================== */

    .premium-footer {

        background:
        linear-gradient(
            135deg,
            #08111d,
            #0f172a
        );

        color: white;

        margin-top: auto;

        padding-top: 70px;

        padding-bottom: 30px;
    }

    .footer-logo {

        color: var(--gold);

        font-weight: 700;

        margin-bottom: 20px;
    }

    .premium-footer h6 {

        color: var(--gold);

        margin-bottom: 20px;

        font-weight: 600;
    }

    .premium-footer ul {

        list-style: none;

        padding: 0;
    }

    .premium-footer li {

        margin-bottom: 12px;
    }

    .premium-footer a {

        color: rgba(255,255,255,.75);

        text-decoration: none;

        transition: .3s;
    }

    .premium-footer a:hover {

        color: var(--gold);
    }

    .footer-text {

        color: rgba(255,255,255,.75);
    }

    .footer-divider {

        border-color: rgba(255,255,255,.1);
    }

    main {
        min-height: 70vh;
    }

</style>
```

</head>

<body>

```
<!-- NAVIGATION -->

<header>

    <nav class="navbar navbar-expand-lg premium-navbar sticky-top">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center gap-2"
               asp-controller="Home"
               asp-action="Index">

                <div class="logo-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <span>
                    Event<span style="color: var(--gold);">Ease</span>
                </span>

            </a>

            <button class="navbar-toggler bg-light"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto me-4">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Venues"
                           asp-action="Index">
                            Explore Venues
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Events"
                           asp-action="Index">
                            Events
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Bookings"
                           asp-action="Index">
                            My Bookings
                        </a>
                    </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                </ul>

                <div>

                    <button class="btn-signin">
                        Sign In
                    </button>

                </div>

            </div>

        </div>

    </nav>

</header>

<!-- CONTENT -->

<div class="flex-grow-1">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-4">
            <div class="alert alert-danger shadow-sm">
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-4">
            <div class="alert alert-success shadow-sm">
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <main role="main">

        @RenderBody()

    </main>

</div>

<!-- FOOTER -->

<footer class="premium-footer">

    <div class="container">

        <div class="row">

            <div class="col-lg-4 mb-4">

                <h3 class="footer-logo">
                    EventEase
                </h3>

                <p class="footer-text">
                    Simplifying venue management,
                    event coordination and bookings
                    through one intelligent platform.
                </p>

            </div>

            <div class="col-lg-2 mb-4">

                <h6>SERVICES</h6>

                <ul>

                    <li>
                        <a asp-controller="Venues"
                           asp-action="Index">
                            Explore Venues
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Bookings"
                           asp-action="Index">
                            Bookings
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Events"
                           asp-action="Index">
                            Events
                        </a>
                    </li>

                </ul>

            </div>

            <div class="col-lg-2 mb-4">

                <h6>COMPANY</h6>

                <ul>

                    <li><a href="#">About</a></li>

                    <li><a href="#">Support</a></li>

                    <li><a href="#">Contact</a></li>

                </ul>

            </div>

            <div class="col-lg-4 mb-4">

                <h6>CONTACT</h6>

                <p class="footer-text">
                    <i class="bi bi-geo-alt me-2"></i>
                    Durban, South Africa
                </p>

                <p class="footer-text">
                    <i class="bi bi-envelope me-2"></i>
                    support@eventease.com
                </p>

                <p class="footer-text">
                    <i class="bi bi-circle-fill text-success me-2"
                       style="font-size:8px;"></i>
                    System Status: Online
                </p>

            </div>

        </div>

        <hr class="footer-divider">

        <div class="text-center footer-text">

            © 2026 EventEase. All Rights Reserved.

        </div>

    </div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
```

</body>
</html>
