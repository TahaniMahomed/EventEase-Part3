@model Event_Ease2.Models.Venue

@{
    ViewData["Title"] = Model.VenueName + " - Details";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-medium hover-underline">
            <i class="bi bi-arrow-left me-2"></i>Back to Explore Venues
        </a>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="position-relative" style="height: 450px;">
                    @if (!string.IsNullOrEmpty(Model.ImageURL))
                    {
                        <img src="@Model.ImageURL" class="w-100 h-100 object-fit-cover" alt="@Model.VenueName">
                    }
                    else
                    {
                        <div class="bg-soft w-100 h-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-building text-secondary opacity-25" style="font-size: 6rem;"></i>
                        </div>
                    }
                    <div class="position-absolute bottom-0 start-0 w-100 p-4 bg-gradient-dark text-white">
                        <h1 class="display-5 fw-bold mb-0">@Model.VenueName</h1>
                        <p class="mb-0 opacity-75"><i class="bi bi-geo-alt-fill me-2 text-danger"></i>@Model.VenueLocation</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold text-dark mb-4 border-bottom pb-2">About this space</h4>
                <p class="text-muted lead">
                    Experience one of Durban's premier hosting locations. Whether you are planning a professional corporate workshop,
                    a private celebration, or a community event, @Model.VenueName offers the perfect blend of style and functionality.
                </p>
                <div class="row mt-4 g-4 text-center">
                    <div class="col-4">
                        <div class="p-3 bg-soft rounded-3">
                            <i class="bi bi-people fs-3 text-primary d-block mb-1"></i>
                            <span class="d-block fw-bold fs-5">@Model.VenueCapacity</span>
                            <small class="text-muted">Capacity</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-soft rounded-3">
                            <i class="bi bi-shield-check fs-3 text-primary d-block mb-1"></i>
                            <span class="d-block fw-bold fs-5">Verified</span>
                            <small class="text-muted">Status</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-soft rounded-3">
                            <i class="bi bi-wifi fs-3 text-primary d-block mb-1"></i>
                            <span class="d-block fw-bold fs-5">Enabled</span>
                            <small class="text-muted">Facilities</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="card border-0 shadow-lg rounded-4 p-4 mb-3 bg-white">
                    <h5 class="fw-bold mb-3">Interested in this space?</h5>
                    <p class="text-muted small mb-4">Check availability and secure your dates for @Model.VenueName.</p>

                    <div class="d-grid gap-3">
                        <a asp-controller="Bookings" asp-action="Create" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 transition-all shadow-sm">
                            Book Now
                        </a>
                        <div class="text-center mt-2">
                            <small class="text-muted italic"><i class="bi bi-info-circle me-1"></i> No immediate payment required</small>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h6 class="fw-bold text-dark small text-uppercase mb-3">Listing Tools</h6>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.VenueID" class="btn btn-outline-secondary w-100 rounded-3">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-3 border">
                            All Venues
                        </a>
                    </div>
                </div>

                <div class="card border-0 bg-dark text-white rounded-4 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary rounded-circle p-2">
                            <i class="bi bi-headset fs-4"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-bold">Need assistance?</p>
                            <small class="opacity-75">Talk to an event expert</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-dark {
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .bg-soft {
        background-color: #f8fafc;
    }

    .hover-underline:hover {
        text-decoration: underline !important;
        color: #0ea5e9 !important;
    }
</style>