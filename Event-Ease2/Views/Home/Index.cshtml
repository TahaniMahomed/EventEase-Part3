@{
    ViewData["Title"] = "Home Page";
}

<div class="homepage">

    <!-- HERO SECTION -->
    <section class="hero-section">

        <div class="hero-overlay"></div>

        <div class="container hero-content">

            <span class="hero-badge">
                Premium Venue Management
            </span>

            <h1 class="hero-title">
                Curating Exceptional Spaces
                <br />
                For Unforgettable Events
            </h1>

            <p class="hero-description">
                Discover premium venues, streamline reservations,
                manage event documentation and track bookings through
                one intelligent platform designed for modern event planning.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Venues"
                   asp-action="Index"
                   class="btn btn-gold">
                    Explore Venues
                </a>

                <a asp-controller="Bookings"
                   asp-action="Index"
                   class="btn btn-outline-light-custom">
                    Manage Bookings
                </a>

            </div>

        </div>

    </section>

    <!-- FEATURES SECTION -->
    <section class="features-section">

        <div class="container">

            <div class="row g-4">

                <!-- CARD 1 -->
                <div class="col-lg-6">

                    <div class="feature-card">

                        <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1000&q=80"
                             class="feature-image"
                             alt="Venue Scheduling" />

                        <div class="feature-content">

                            <h3>Seamless Availability</h3>

                            <p>
                                Instantly view venue availability,
                                manage reservations and synchronize bookings
                                through a centralized scheduling platform.
                            </p>

                        </div>

                    </div>

                </div>

                <!-- CARD 2 -->
                <div class="col-lg-6">

                    <div class="feature-card">

                        <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1000&q=80"
                             class="feature-image"
                             alt="Document Storage" />

                        <div class="feature-content">

                            <h3>Secure Document Vault</h3>

                            <p>
                                Safely store contracts, floor plans,
                                event agreements and supporting documentation
                                within a secure cloud repository.
                            </p>

                        </div>

                    </div>

                </div>

                <!-- CARD 3 -->
                <div class="col-lg-6">

                    <div class="feature-card">

                        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1000&q=80"
                             class="feature-image"
                             alt="Tracking" />

                        <div class="feature-content">

                            <h3>End-to-End Tracking</h3>

                            <p>
                                Monitor every stage of the venue booking
                                lifecycle from inquiry through event completion.
                            </p>

                        </div>

                    </div>

                </div>

                <!-- CARD 4 -->
                <div class="col-lg-6">

                    <div class="feature-card">

                        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1000&q=80"
                             class="feature-image"
                             alt="Analytics" />

                        <div class="feature-content">

                            <h3>Venue Insights & Analytics</h3>

                            <p>
                                Generate meaningful reports,
                                occupancy trends and booking statistics
                                to support better business decisions.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

<style>

    :root {
        --gold: #c8a96a;
        --dark: #0f1720;
        --light: #ffffff;
        --gray: #f5f5f5;
    }

    body {
        background-color: #fafafa;
    }

    /* HERO SECTION */

    .hero-section {
        position: relative;
        min-height: 90vh;
        background: linear-gradient( rgba(10,15,25,0.65), rgba(10,15,25,0.75) ), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=80');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(200,169,106,.15);
        border: 1px solid rgba(200,169,106,.4);
        color: var(--gold);
        padding: 10px 20px;
        border-radius: 50px;
        margin-bottom: 25px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .hero-title {
        color: white;
        font-size: 4rem;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 25px;
    }

    .hero-description {
        color: rgba(255,255,255,.85);
        font-size: 1.2rem;
        margin-bottom: 40px;
        max-width: 650px;
    }

    .hero-buttons {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-gold {
        background: var(--gold);
        color: white;
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        transition: .3s;
    }

        .btn-gold:hover {
            transform: translateY(-3px);
            background: #b89554;
            color: white;
        }

    .btn-outline-light-custom {
        border: 1px solid rgba(255,255,255,.5);
        color: white;
        padding: 14px 35px;
        border-radius: 50px;
        text-decoration: none;
        transition: .3s;
    }

        .btn-outline-light-custom:hover {
            background: white;
            color: var(--dark);
        }

    /* FEATURES */

    .features-section {
        padding: 80px 0;
        background: #fafafa;
    }

    .feature-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        transition: .3s;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
        }

    .feature-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
    }

    .feature-content {
        padding: 30px;
    }

        .feature-content h3 {
            color: var(--dark);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .feature-content p {
            color: #666;
            margin-bottom: 0;
            line-height: 1.7;
        }

    @@media(max-width:768px) {

        .hero-title {
            font-size: 2.6rem;
        }
    }
   
</style>