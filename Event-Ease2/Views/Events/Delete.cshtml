@model Event_Ease2.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-danger py-4 text-center text-white">
                    <i class="bi bi-calendar-x-fill display-4"></i>
                    <h2 class="fw-bold mt-2 mb-0">Cancel Event?</h2>
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-muted mb-4 fs-5">
                        You are about to permanently delete <span class="fw-bold text-dark">@Model.EventName</span>. All data associated with this event will be lost.
                    </p>

                    <div class="bg-soft rounded-4 p-3 mb-4 border text-start">
                        <h6 class="text-uppercase text-muted small fw-bold mb-1">Event Name</h6>
                        <p class="fw-bold text-dark mb-3">@Model.EventName</p>

                        <h6 class="text-uppercase text-muted small fw-bold mb-1">Description</h6>
                        <p class="text-muted small mb-0">
                            @(string.IsNullOrEmpty(Model.EventDescription) ? "No description provided." : Model.EventDescription)
                        </p>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="EventID" />
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm transition-all">
                                Permanent Delete
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-bold py-3 border">
                                Keep Event
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <div class="d-inline-flex align-items-center p-2 px-3 bg-white border rounded-pill shadow-sm">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    <span class="small text-muted">Active bookings for this event will be impacted.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft {
        background-color: #f8fafc;
    }

    .btn-danger {
        background-color: #ef4444;
        border: none;
    }

        .btn-danger:hover {
            background-color: #dc2626;
            transform: scale(1.02);
        }
</style>