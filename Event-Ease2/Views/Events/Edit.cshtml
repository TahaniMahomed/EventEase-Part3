@model Event_Ease2.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <nav class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Back to Events
                </a>
            </nav>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary p-4 text-white">
                    <h3 class="fw-bold mb-0">Update Event Brief</h3>
                    <p class="small opacity-75 mb-0">Refine the details for "@Model.EventName"</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4"></div>
                        <input type="hidden" asp-for="EventID" />

                        <div class="form-floating mb-4">
                            <input asp-for="EventName" class="form-control border-0 bg-soft shadow-none fw-bold" placeholder="Event Name" />
                            <label asp-for="EventName" class="text-muted">Event Name</label>
                            <span asp-validation-for="EventName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <select asp-for="EventTypeID" asp-items="ViewBag.EventTypeID" class="form-select border-0 bg-soft shadow-none" style="font-size: 1rem;">
                                <option value="" disabled>-- Select an Event Category --</option>
                            </select>
                            <label asp-for="EventTypeID" class="text-muted">Event Category Type</label>
                            <span asp-validation-for="EventTypeID" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="EventDescription" class="form-control border-0 bg-soft shadow-none" placeholder="Description" style="height: 180px;"></textarea>
                            <label asp-for="EventDescription" class="text-muted">Event Description</label>
                            <span asp-validation-for="EventDescription" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-3 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm transition-all">
                                Save Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.EventID" class="btn btn-link text-muted text-decoration-none small">
                                Discard Changes
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft {
        background-color: #f1f5f9;
    }

    textarea.form-control {
        resize: none;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-select:focus ~ label {
        color: #0ea5e9;
        font-weight: 600;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.2);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}