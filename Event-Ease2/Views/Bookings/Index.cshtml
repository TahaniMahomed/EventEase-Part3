@model IEnumerable<Event_Ease2.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container py-5">
    <div class="row mb-5 align-items-center">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold text-dark" style="letter-spacing: -1.5px;">
                My <span class="text-primary">Reservations</span>
            </h1>
            <p class="text-muted fs-5">Manage your upcoming event schedules and venue details in one place.</p>
        </div>
        <div class="col-md-5 text-md-end">
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm px-4 rounded-3 fw-bold transition-all">
                <i class="bi bi-calendar-plus me-2"></i>New Reservation
            </a>
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-sliders me-2 text-primary"></i>Advanced Filtering Dashboard</h5>
                <form asp-controller="Bookings" asp-action="Index" method="get" class="row g-3">
                    
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Keyword Search</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchString" class="form-control border-0 bg-transparent shadow-none"
                                   placeholder="Event name or reference ID..."
                                   value="@ViewData["CurrentSearch"]">
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Event Category Type</label>
                        <select name="eventTypeId" asp-items="ViewBag.EventTypeID" class="form-select border rounded-3 py-2 shadow-none bg-light">
                            <option value="">-- All Categories --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Target Venue</label>
                        <select name="venueId" asp-items="ViewBag.VenueID" class="form-select border rounded-3 py-2 shadow-none bg-light">
                            <option value="">-- All Venues --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Scheduled From Date</label>
                        <input type="datetime-local" name="filterStartDate" value="@ViewData["FilterStartDate"]" class="form-control border rounded-3 py-2 shadow-none bg-light" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Scheduled To Date</label>
                        <input type="datetime-local" name="filterEndDate" value="@ViewData["FilterEndDate"]" class="form-control border rounded-3 py-2 shadow-none bg-light" />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-dark w-100 rounded-3 fw-bold py-2 me-2" type="submit">
                            <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 px-3" title="Clear Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
            
            @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) || Context.Request.Query["eventTypeId"].Count > 0 || Context.Request.Query["venueId"].Count > 0 || Context.Request.Query["filterStartDate"].Count > 0 || Context.Request.Query["filterEndDate"].Count > 0)
            {
                <div class="mt-3 ps-2">
                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3 text-muted fw-medium">
                        <i class="bi bi-x-lg me-1"></i> Clear All Filter Tags
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @foreach (var item in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden transition-all booking-card">
                    <div class="row g-0">
                        <div class="col-md-2 bg-soft d-flex flex-column align-items-center justify-content-center border-end py-4">
                            <span class="text-uppercase small fw-bold text-muted mb-1" style="letter-spacing: 1px;">Booking ID</span>
                            <span class="badge bg-white text-dark border px-2 py-1 mb-3 rounded-2 small shadow-xs">#@item.BookingID</span>
                            <h3 class="fw-bold text-dark mb-0">@item.BookingDate.ToString("dd")</h3>
                            <span class="fw-medium text-primary text-uppercase" style="font-size: 0.85rem;">@item.BookingDate.ToString("MMM yyyy")</span>
                        </div>

                        <div class="col-md-7 p-4">
                            <div class="d-flex align-items-center mb-3 flex-wrap gap-2">
                                <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-patch-check-fill me-1"></i> Confirmed
                                </span>
                                @if(item.Event?.EventType != null)
                                {
                                    <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-tag-fill me-1"></i> @item.Event.EventType.EventTypeName
                                    </span>
                                }
                                <h4 class="fw-bold mb-0 text-dark ms-1">@item.Event.EventName</h4>
                            </div>

                            <p class="text-muted mb-4 d-flex align-items-center">
                                <i class="bi bi-geo-alt text-danger me-2"></i> @item.Venue.VenueName
                            </p>

                            <div class="row g-3">
                                <div class="col-auto">
                                    <div class="bg-white border rounded-3 px-3 py-2">
                                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem;">Check In</small>
                                        <span class="fw-semibold text-dark">@item.StartDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-auto d-flex align-items-center">
                                    <i class="bi bi-arrow-right text-muted"></i>
                                </div>
                                <div class="col-auto">
                                    <div class="bg-white border rounded-3 px-3 py-2">
                                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem;">Check Out</small>
                                        <span class="fw-semibold text-dark">@item.EndDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-center justify-content-center bg-white p-4">
                            <div class="d-flex flex-column gap-2 w-100">
                                <a asp-action="Details" asp-route-id="@item.BookingID" class="btn btn-outline-primary fw-bold rounded-3 py-2">
                                    View Receipt
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.BookingID" class="btn btn-light border flex-grow-1 rounded-3 py-2" title="Edit Date">
                                        <i class="bi bi-pencil-square text-warning"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.BookingID" class="btn btn-light border flex-grow-1 rounded-3 py-2" title="Cancel Booking">
                                        <i class="bi bi-trash3 text-danger"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 border border-dashed shadow-sm">
                    <div class="bg-soft rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-calendar-x text-muted display-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark">No Bookings Found</h3>
                    <p class="text-muted mx-auto" style="max-width: 400px;">No entries match your search filters. Try widening your criteria parameters or resetting the lookup dashboard tags.</p>
                    <a asp-controller="Venues" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">Explore Venues</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Status Badge Refinements */
    .bg-success-soft {
        background-color: #ecfdf5;
        color: #059669;
    }
    
    .bg-primary-soft {
        background-color: #eff6ff;
        color: #2563eb;
    }

    .border-dashed {
        border-style: dashed !important;
        border-width: 2px !important;
        border-color: #e2e8f0 !important;
    }

    /* Booking Card Specific Hover */
    .booking-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.1) !important;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
    
    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>